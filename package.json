{
  "name": "fahsai-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Fahsai's public fire, air quality, weather, and power plant data for mainland Southeast Asia and surrounding areas",
  "type": "module",
  "bin": {
    "fahsai-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoostKiens/fahsai-mcp-server.git"
  },
  "license": "MIT",
  "author": "Joost Kiens",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest",
    "test:live": "LIVE=true vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
